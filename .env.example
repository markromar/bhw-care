# BHW Care - environment template.
# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git. This example file IS committed, so keep placeholders only.
#
# ONLY public client values belong here. Anything starting with EXPO_PUBLIC_ is
# compiled into the app bundle and can be read by anyone who has the app.
#
# NEVER put these in any .env file inside this project:
#   - the Supabase service_role / secret key
#   - the PhilSMS API token
#   - any admin or private key
# Those live server-side only (Supabase Edge Function secrets).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key